set sdc_version 2.0

set_units -capacitance 1000fF
set_units -time 1000ps

# Set the current design
current_design uart_top

create_clock -name "MAIN_CLOCK" -period 20.0 -waveform {0.0 10.0} [get_ports clk]
set_clock_transition 0.1 [get_clocks MAIN_CLOCK]
set_load -pin_load 0.003 [get_ports tx_busy]
set_load -pin_load 0.003 [get_ports tx_done]
set_load -pin_load 0.003 [get_ports {rx_data[7]}]
set_load -pin_load 0.003 [get_ports {rx_data[6]}]
set_load -pin_load 0.003 [get_ports {rx_data[5]}]
set_load -pin_load 0.003 [get_ports {rx_data[4]}]
set_load -pin_load 0.003 [get_ports {rx_data[3]}]
set_load -pin_load 0.003 [get_ports {rx_data[2]}]
set_load -pin_load 0.003 [get_ports {rx_data[1]}]
set_load -pin_load 0.003 [get_ports {rx_data[0]}]
set_load -pin_load 0.003 [get_ports rx_valid]
set_load -pin_load 0.003 [get_ports frame_error]
set_load -pin_load 0.003 [get_ports uart_tx]
set_false_path -from [get_ports uart_rx]
set_clock_gating_check -setup 0.0 
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports tx_start]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports {tx_data[7]}]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports {tx_data[6]}]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports {tx_data[5]}]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports {tx_data[4]}]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports {tx_data[3]}]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports {tx_data[2]}]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports {tx_data[1]}]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports {tx_data[0]}]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min 0.01 [get_ports tx_start]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min 0.01 [get_ports {tx_data[7]}]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min 0.01 [get_ports {tx_data[6]}]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min 0.01 [get_ports {tx_data[5]}]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min 0.01 [get_ports {tx_data[4]}]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min 0.01 [get_ports {tx_data[3]}]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min 0.01 [get_ports {tx_data[2]}]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min 0.01 [get_ports {tx_data[1]}]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min 0.01 [get_ports {tx_data[0]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports tx_busy]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports tx_done]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports {rx_data[7]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports {rx_data[6]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports {rx_data[5]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports {rx_data[4]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports {rx_data[3]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports {rx_data[2]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports {rx_data[1]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports {rx_data[0]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports rx_valid]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports frame_error]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports uart_tx]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min -0.01 [get_ports tx_busy]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min -0.01 [get_ports tx_done]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min -0.01 [get_ports {rx_data[7]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min -0.01 [get_ports {rx_data[6]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min -0.01 [get_ports {rx_data[5]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min -0.01 [get_ports {rx_data[4]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min -0.01 [get_ports {rx_data[3]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min -0.01 [get_ports {rx_data[2]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min -0.01 [get_ports {rx_data[1]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min -0.01 [get_ports {rx_data[0]}]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min -0.01 [get_ports rx_valid]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min -0.01 [get_ports frame_error]
set_output_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min -0.01 [get_ports uart_tx]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -max 0.1 [get_ports reset_n]
set_input_delay -clock [get_clocks MAIN_CLOCK] -add_delay -min 0.01 [get_ports reset_n]
set_operating_conditions -max_library slow_vdd1v0 -min_library library:default_emulate_libset_max/fast_vdd1v0 -min PVT_1P1V_0C -max PVT_0P9V_125C
set_input_transition 0.1 [get_ports reset_n]
set_input_transition 0.1 [get_ports tx_start]
set_input_transition 0.1 [get_ports {tx_data[7]}]
set_input_transition 0.1 [get_ports {tx_data[6]}]
set_input_transition 0.1 [get_ports {tx_data[5]}]
set_input_transition 0.1 [get_ports {tx_data[4]}]
set_input_transition 0.1 [get_ports {tx_data[3]}]
set_input_transition 0.1 [get_ports {tx_data[2]}]
set_input_transition 0.1 [get_ports {tx_data[1]}]
set_input_transition 0.1 [get_ports {tx_data[0]}]
set_input_transition 0.1 [get_ports uart_rx]
set_dont_use true [get_lib_cells fast_vdd1v0/BUFX2]
set_clock_uncertainty -setup 0.1 [get_clocks MAIN_CLOCK]
