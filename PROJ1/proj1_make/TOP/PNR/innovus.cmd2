#@(#)CDS: Innovus v22.17-s086_1 (64bit) 09/24/2024 10:51 (Linux 3.10.0-693.el7.x86_64)
#@(#)CDS: NanoRoute 22.17-s086_1 NR240905-1647/22_17-UB (database version 18.20.629) {superthreading v2.20}
#@(#)CDS: AAE 22.17-s013 (64bit) 09/24/2024 (Linux 3.10.0-693.el7.x86_64)
#@(#)CDS: CTE 22.17-s017_1 () Sep 12 2024 04:53:54 ( )
#@(#)CDS: SYNTECH 22.17-s006_1 () Aug 12 2024 03:52:27 ( )
#@(#)CDS: CPE v22.17-s051
#@(#)CDS: IQuantus/TQuantus 21.2.2-s369 (64bit) Tue May 7 14:30:42 PDT 2024 (Linux 3.10.0-693.el7.x86_64)

set_global _enable_mmmc_by_default_flow      $CTE::mmmc_default
suppressMessage ENCEXT-2799
win
set enc_check_rename_command_name 1
restoreDesign InitDesign.dat
globalNetConnect VDD -type pgpin -pin VDD -instanceBasename *
globalNetConnect VSS -type pgpin -pin VSS -instanceBasename *
globalNetConnect VDD -type tiehi -instanceBasename *
globalNetConnect VSS -type tielo -instanceBasename *
setTieHiLoMode -reset
setTieHiLoMode -cell {TIELO TIEHI} -honorDontTouch false -createHierPort false
addRing -nets {VDD VSS} -type core_rings -follow core -layer {top Metal11 bottom Metal11 left Metal10 right Metal10} -width 0.8 -spacing 0.8 -offset 0.8
setAddStripeMode -stacked_via_top_layer Metal11 -stacked_via_bottom_layer Metal1
addStripe -nets {VDD VSS} -layer Metal10 -direction vertical -width 0.8 -spacing 0.8 -set_to_set_distance 16 -start_from left -start_offset 7
createPGPin -onDie -net VDD -width 0.8 -length 2.0
createPGPin -onDie -net VSS -width 0.8 -length 2.0
sroute -connect corePin -corePinTarget firstAfterRowEnd -layerChangeRange {Metal1 Metal11} -allowJogging 1 -allowLayerChange 1 -nets {VDD VSS}
verifyConnectivity -type special -nets {VDD VSS} -report reports/pg_connectivity.rpt
saveDesign -def PowerPlan
