#@(#)CDS: IQuantus/TQuantus 21.2.2-s369 (64bit) Tue May 7 14:30:42 PDT 2024 (Linux 3.10.0-693.el7.x86_64)

set_global _enable_mmmc_by_default_flow      $CTE::mmmc_default
suppressMessage ENCEXT-2799
win
set enc_check_rename_command_name 1
restoreDesign PlaceOpt.dat
set_interactive_constraint_modes [list FUNC]
set_dont_use true $lib_cells
create_ccopt_clock_tree_spec
set_ccopt_property buffer_cells {BUFX12 BUFX16 BUFX20 BUFX3 BUFX4 BUFX6 BUFX8 CLKBUFX12 CLKBUFX16 CLKBUFX2 CLKBUFX20 CLKBUFX3 CLKBUFX4 CLKBUFX6 CLKBUFX8}
set_ccopt_property inverter_cells {CLKINVX1 CLKINVX12 CLKINVX16 CLKINVX2 CLKINVX20 CLKINVX3 CLKINVX4 CLKINVX6 CLKINVX8 INVX1 INVX12 INVX16 INVX2 INVX20 INVX3 INVX4 INVX6 INVX8 INVXL}
ccopt_design
set_interactive_constraint_modes [list FUNC]
set_propagated_clock [get_clocks MAIN_CLOCK]
optDesign -postCTS
optDesign -postCTS -hold
report_ccopt_clock_trees -file reports/clock_trees.rpt
report_ccopt_skew_groups -file reports/clock_skew_groups.rpt
timeDesign -postCTS -outDir reports/timing/postCTS/setup
timeDesign -postCTS -hold -outDir reports/timing/postCTS/hold
saveDesign -def PostCTSopt
