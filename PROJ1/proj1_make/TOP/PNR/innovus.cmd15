#@(#)CDS: SYNTECH 22.17-s006_1 () Aug 12 2024 03:52:27 ( )
#@(#)CDS: CPE v22.17-s051
#@(#)CDS: IQuantus/TQuantus 21.2.2-s369 (64bit) Tue May 7 14:30:42 PDT 2024 (Linux 3.10.0-693.el7.x86_64)

set_global _enable_mmmc_by_default_flow      $CTE::mmmc_default
suppressMessage ENCEXT-2799
win
set enc_check_rename_command_name 1
restoreDesign PostCTSopt.dat
set_interactive_constraint_modes [list FUNC]
set_dont_use true $lib_cells
setNanoRouteMode -routeTopRoutingLayer 11 -routeBottomRoutingLayer 1
setNanoRouteMode -routeWithTimingDriven true -routeWithSiDriven true
setNanoRouteMode -drouteFixAntenna true -routeInsertAntennaDiode false
routeDesign -globalDetail
set_interactive_constraint_modes [list FUNC]
set_propagated_clock [get_clocks MAIN_CLOCK]
setAnalysisMode -analysisType onChipVariation
extractRC
optDesign -postRoute -setup
optDesign -postRoute -hold
set_interactive_constraint_modes [list FUNC]
set_propagated_clock [get_clocks MAIN_CLOCK]
extractRC
timeDesign -postRoute -outDir reports/timing/postRoute/setup
timeDesign -postRoute -hold -outDir reports/timing/postRoute/hold
setAnalysisMode -checkType setup
report_timing -check_type recovery -from [get_ports reset_n] -path_type full_clock  -max_paths 10 > [file join $dir reset_recovery.rpt]
setAnalysisMode -checkType hold
report_timing -check_type removal -from [get_ports reset_n] -path_type full_clock  -max_paths 10 > [file join $dir reset_removal.rpt]
set_verify_drc_mode -report reports/route_drc.rpt
verify_drc
verifyConnectivity -type all -geomConnect -report reports/route_connectivity.rpt
saveDesign -rc -def RouteDesign
