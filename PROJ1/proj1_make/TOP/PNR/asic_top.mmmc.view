# GPDK045 MMMC; do not reuse the unrelated cln28hpl capacitance table.
source [file join [file dirname [info script]] pnr_config.tcl]
require_pnr_file $qrc_tech
set ff_libs [list [file join $std_root gsclib045 timing fast_vdd1v0_basicCells.lib] [file join $io_root timing pads_FF_s1vg.lib]]
set ss_libs [list [file join $std_root gsclib045 timing slow_vdd1v0_basicCells.lib] [file join $io_root timing pads_SS_s1vg.lib]]
foreach lib [concat $ff_libs $ss_libs] { require_pnr_file $lib }
set uart_sdc [file normalize [file join $pnr_dir ../SYN/mapped/asic_top_syn_final.sdc]]
require_pnr_file $uart_sdc
create_rc_corner -name BEST -qx_tech_file $qrc_tech -T 0
create_rc_corner -name WORST -qx_tech_file $qrc_tech -T 125
create_library_set -name FF_LIBS -timing $ff_libs
create_library_set -name SS_LIBS -timing $ss_libs
create_delay_corner -name FF_BEST -library_set FF_LIBS -rc_corner BEST
create_delay_corner -name SS_WORST -library_set SS_LIBS -rc_corner WORST
create_constraint_mode -name FUNC -sdc_files [list $uart_sdc]
create_analysis_view -name FUNC_FF_BEST -constraint_mode FUNC -delay_corner FF_BEST
create_analysis_view -name FUNC_SS_WORST -constraint_mode FUNC -delay_corner SS_WORST
set_analysis_view -setup [list FUNC_SS_WORST] -hold [list FUNC_FF_BEST]
